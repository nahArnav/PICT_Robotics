{
  "name": "figma-make-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:database": "node tests/database.mjs",
    "test:e2e": "playwright test",
    "dev:local": "node tests/dev-server.mjs",
    "dev": "vite",
    "build": "vite build",
    "build:production": "node scripts/validate-production-env.mjs && pnpm typecheck && pnpm test && pnpm build",
    "preview": "vite preview",
    "format": "oxfmt"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.73.0",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0 <25"
  },
  "packageManager": "pnpm@10.34.3"
}
